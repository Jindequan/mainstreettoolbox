# 复制为 .env 并按需填写。全部可选——不配置时站点以纯静态模式运行。
# 公开变量（进入客户端构建），不含任何密钥。

# 使用统计 Worker（worker/ 目录，部署后得到 *。workers.dev 地址）
PUBLIC_STATS_API=

# 隐私分析（cookieless，无 cookie 横幅）
PUBLIC_PLAUSIBLE_DOMAIN=

# Google Search Console 验证
PUBLIC_GSC_TOKEN=

# Concierge intake 表单端点（如 Formspree）
PUBLIC_FORM_ENDPOINT=

# M2 起启用：SaaS Core 首版 = 共享 Supabase 项目（存在即切换 supabase 适配器）
PUBLIC_SAASCORE_URL=
PUBLIC_GA_ID=
