      .cs-cols th { background: #f2f0ea; }
      .cs-foot { margin-top: 14px; font: 500 10px "Inter"; color: #666; border-top: 1px solid #ccc; padding-top: 6px; }
    }
  </style>

  <script>
    // —— Retail Math Calculator：四模块实时演算（静态输入，只更新输出，不重建 DOM） ——
    import { beaconUse } from '../../scripts/stats';

    const money = (v: number) => '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const $id = (s: string) => document.getElementById(s) as HTMLInputElement;
    const num = (el: HTMLInputElement) => { const n = parseFloat(el.value.replace(/[^0-9.]/g, '')); return Number.isFinite(n) ? n : 0; };
    let counted = false;
    const countUse = () => { if (!counted) { counted = true; beaconUse('retail-math-calculator'); } };

    function calcPrice() {
      const cost = num($id('p-cost'));
      const mode = ($id('p-mode') as unknown as HTMLSelectElement).value;
      const v = num($id('p-val'));
      let price = 0;
      if (mode === 'markup') price = cost * (1 + v / 100);
      else if (mode === 'margin') price = v < 100 ? cost / (1 - v / 100) : 0;
      else price = v;
      const profit = price - cost;
      const markup = cost > 0 ? (profit / cost) * 100 : 0;
      const margin = price > 0 ? (profit / price) * 100 : 0;
      ($id('p-price') as HTMLElement).textContent = money(price);
      ($id('p-profit') as HTMLElement).textContent = money(profit);
      ($id('p-markup') as HTMLElement).textContent = `${markup.toFixed(1)}%`;
      ($id('p-margin') as HTMLElement).textContent = `${margin.toFixed(1)}%`;
      return { cost, price, profit, markup, margin };
    }

    function calcMarkdown() {
      const cost = num($id('m-cost')), orig = num($id('m-orig')), off = num($id('m-off'));
      const sale = orig * (1 - Math.min(100, off) / 100);
      const baseMargin = orig > 0 ? ((orig - cost) / orig) * 100 : 0;
      const saleMargin = sale > 0 ? ((sale - cost) / sale) * 100 : 0;
      const note = document.getElementById('m-note') as HTMLElement;
      if (baseMargin <= off) {
        ($id('m-sale') as HTMLElement).textContent = money(sale);
        ($id('m-margin') as HTMLElement).textContent = `${saleMargin.toFixed(1)}%`;
        ($id('m-lift') as HTMLElement).textContent = '—';
        note.textContent = `A ${off}% discount on a ${baseMargin.toFixed(1)}% margin loses money on every unit — no volume can make it up.`;
        note.className = 'mod-note warn';
      } else {
        const lift = (off / (baseMargin - off)) * 100;
        ($id('m-sale') as HTMLElement).textContent = money(sale);
        ($id('m-margin') as HTMLElement).textContent = `${saleMargin.toFixed(1)}%`;
        ($id('m-lift') as HTMLElement).textContent = `+${lift.toFixed(0)}%`;
        note.textContent = `A ${baseMargin.toFixed(0)}% margin survives a ${off}% cut only if volume rises ${lift.toFixed(0)}% — run it when the shelf is full and traffic is up.`;
        note.className = 'mod-note';
      }
      return { sale, saleMargin, off, baseMargin };
    }

    function calcSellThrough() {
      const recv = num($id('s-recv')), sold = num($id('s-sold')), weeks = Math.max(0.5, num($id('s-weeks')));
      const pct = recv > 0 ? (sold / recv) * 100 : 0;
      const rate = sold / weeks;
      const left = rate > 0 ? (recv - sold) / rate : 0;
      ($id('s-pct') as HTMLElement).textContent = `${pct.toFixed(0)}%`;
      ($id('s-rate') as HTMLElement).textContent = `${rate.toFixed(1)} units`;
      ($id('s-left') as HTMLElement).textContent = recv > sold ? left.toFixed(1) : '—';
      const note = document.getElementById('s-note') as HTMLElement;
      if (recv > 0 && sold > recv) { note.textContent = 'Sold more than received — check for transfers or miscounts in the intake.'; note.className = 'mod-note warn'; }
      else if (pct >= 70) { note.textContent = 'Healthy pace for seasonal goods — you should exit the season without heavy markdowns.'; note.className = 'mod-note'; }
      else if (pct >= 40) { note.textContent = 'Mid-season range. Watch it weekly — below ~40% by mid-season is where markdowns start.'; note.className = 'mod-note'; }
      else { note.textContent = 'Slow — the buy may be too deep. Plan the markdown while the margin can still absorb it.'; note.className = 'mod-note warn'; }
      return { pct, rate, left };
    }

    function calcBreakEven() {
      const fixed = num($id('b-fixed')), price = num($id('b-price')), uc = num($id('b-cost'));
      const unitMargin = price - uc;
      const units = unitMargin > 0 ? Math.ceil(fixed / unitMargin) : Infinity;
      ($id('b-units') as HTMLElement).textContent = Number.isFinite(units) ? units.toLocaleString('en-US') : '—';
      ($id('b-rev') as HTMLElement).textContent = Number.isFinite(units) ? money(units * price) : '—';
      ($id('b-day') as HTMLElement).textContent = Number.isFinite(units) ? `≈ ${(units / 26).toFixed(1)} units` : '—';
      const note = document.getElementById('b-note') as HTMLElement;
      if (!Number.isFinite(units)) { note.textContent = `At $${price} price against $${uc} unit cost, every sale loses ${money(uc - price)} — price above unit cost to have a break-even.`; note.className = 'mod-note warn'; }
      else { note.textContent = `${units.toLocaleString('en-US')} units a month covers ${money(fixed)} of fixed costs; every unit past that earns ${money(unitMargin)}.`; note.className = 'mod-note'; }
    }

    function renderAll() {
      const p = calcPrice(), m = calcMarkdown(), s = calcSellThrough();
      calcBreakEven();
      (document.getElementById('cs-yours') as HTMLElement).textContent =
        `cost ${money(p.cost)} → price ${money(p.price)} (markup ${p.markup.toFixed(0)}%, margin ${p.margin.toFixed(0)}%)\n` +
        `${m.off}% off ${money(p.price)} → ${money(m.sale)} · lift +${(m.baseMargin > m.off ? ((m.off / (m.baseMargin - m.off)) * 100).toFixed(0) : '—')}%\n` +
        `sell-through ${s.pct.toFixed(0)}% · break-even ${($id('b-units') as HTMLElement).textContent} units/mo`;
      try {
        localStorage.setItem('mst-retail-math', JSON.stringify({
          pc: $id('p-cost').value, pm: ($id('p-mode') as HTMLSelectElement).value, pv: $id('p-val').value,
          mc: $id('m-cost').value, mo: $id('m-orig').value, mf: $id('m-off').value,
          sr: $id('s-recv').value, ss: $id('s-sold').value, sw: $id('s-weeks').value,
          bf: $id('b-fixed').value, bp: $id('b-price').value, bc: $id('b-cost').value,
        }));
      } catch {}
    }

    const IDS = ['p-cost', 'p-mode', 'p-val', 'm-cost', 'm-orig', 'm-off', 's-recv', 's-sold', 's-weeks', 'b-fixed', 'b-price', 'b-cost'];
    for (const id of IDS) {
      document.getElementById(id)!.addEventListener('input', () => { countUse(); renderAll(); });
      document.getElementById(id)!.addEventListener('change', () => { countUse(); renderAll(); });
    }
    $id('p-mode').addEventListener('change', () => {
      ($id('p-val-lbl') as HTMLElement).textContent = ($id('p-mode') as HTMLSelectElement).value === 'markup' ? 'Markup %'
        : ($id('p-mode') as HTMLSelectElement).value === 'margin' ? 'Margin %' : 'Price $';
    });
    document.getElementById('do-print')!.addEventListener('click', () => window.print());

    // 草稿恢复
    try {
      const d = JSON.parse(localStorage.getItem('mst-retail-math') ?? 'null') as Record<string, string> | null;
      if (d) {
        const map: Record<string, string> = { 'p-cost': d.pc, 'p-mode': d.pm, 'p-val': d.pv, 'm-cost': d.mc, 'm-orig': d.mo, 'm-off': d.mf, 's-recv': d.sr, 's-sold': d.ss, 's-weeks': d.sw, 'b-fixed': d.bf, 'b-price': d.bp, 'b-cost': d.bc };
        for (const [id, v] of Object.entries(map)) if (v !== undefined && v !== null) $id(id).value = v;
        ($id('p-val-lbl') as HTMLElement).textContent = ($id('p-mode') as HTMLSelectElement).value === 'markup' ? 'Markup %'
          : ($id('p-mode') as HTMLSelectElement).value === 'margin' ? 'Margin %' : 'Price $';
      }
    } catch {}
    renderAll();
  </script>
</BaseLayout>
