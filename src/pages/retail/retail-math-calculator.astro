      .nav, .industry-hero, .workbench, .prose, .faq, .related, footer.site { display: none !important; }
      body { background: #fff; }
      .cheatsheet { display: block; margin: 10mm 12mm; }
      .cs-brand { font: 700 17px var(--font-display); letter-spacing: .12em; color: #111; border-bottom: 2px solid #111; padding-bottom: 8px; }
      .cs-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 12px; }
      .cs-cols h3 { font: 700 11px "Inter"; letter-spacing: .08em; text-transform: uppercase; color: #111; margin: 10px 0 6px; }
      .cs-cols p { font: 500 12px "Inter"; color: #222; margin-bottom: 4px; }
      .cs-cols table { border-collapse: collapse; margin-top: 6px; }
