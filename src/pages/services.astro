---
import BaseLayout from '../layouts/BaseLayout.astro';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
---
<BaseLayout
  title="Concierge Setup — We build your cost system for you | Main Street Toolbox"
  description="Send us your purchase records and menu — we set up your complete cost chain and hand back a working system plus a printable monthly report. Founding price $99."
  path="/services/"
>
  <section class="section" style="padding-bottom:12px">
    <div class="container" style="max-width:52rem">
      <span class="eyebrow">Concierge setup</span>
      <h1 style="font-size:var(--fs-800);margin:12px 0 8px">Don't want to do the numbers?<br/>We'll do them <em style="color:var(--green)">for</em> you.</h1>
      <p style="color:var(--ink-2);max-width:38rem;font-size:1.0625rem">
        Snap your purchase records, your menu and last month's sales. We build your complete cost chain —
        plate costs, menu pricing, prime cost and a monthly profit picture — and hand it back as a working
        system you can keep using for free, plus a clean printable report.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:16px">
    <div class="container" style="max-width:52rem">
      <div class="card card-pad form-card">
        <h2 style="font-size:var(--fs-600);margin-bottom:16px">Tell us about your business</h2>
        {endpoint ? (
          <form action={endpoint} method="POST">
            <div class="field"><label for="s-name">Your name</label><input class="input" id="s-name" name="name" required /></div>
            <div class="field"><label for="s-email">Email</label><input class="input" id="s-email" name="email" type="email" required /></div>
            <div class="field">
              <label for="s-type">Business type</label>
              <select class="input" id="s-type" name="type">
                <option>Restaurant / café / bar</option>
                <option>Cleaning business</option>
                <option>Lawn care</option>
                <option>Construction / handyman</option>
                <option>Salon / barber</option>
                <option>Retail shop</option>
                <option>Other small business</option>
              </select>
            </div>
            <div class="field"><label for="s-data">What records do you have?</label><textarea id="s-data" name="data" placeholder="e.g. supplier invoices, a menu, last month's sales…"></textarea></div>
            <div class="field"><label for="s-goal">What do you want to know?</label><textarea id="s-goal" name="goal" placeholder="e.g. what each dish really costs me, and what I should charge…"></textarea></div>
            <button class="btn btn-primary" type="submit" style="width:100%">Request a setup — $99 founding price</button>
            <p class="form-note">5 setups per month, first come first served. Requires a Main Street Toolbox Pro subscription ($9/mo) so your system stays updated. We reply by email — no calls, no sales pitch.</p>
          </form>
        ) : (
          <div>
            <p style="color:var(--ink-2)">Intake is opening soon. Email
              <a href="mailto:feedback@mainstreettoolbox.com?subject=Concierge%20setup">feedback@mainstreettoolbox.com</a>
              with your business type and what you'd like to know, and we'll take it from there.</p>
            <p class="form-note">5 setups per month · founding price $99 · reply by email, no calls, no sales pitch.</p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
