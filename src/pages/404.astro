---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Main Street Toolbox" description="That page doesn't exist. Head back to the toolbox." path="/404">
  <section class="section" style="text-align:center;padding:96px 0">
    <div class="container">
      <h1 style="font-size:var(--fs-900);margin-bottom:12px">Nothing on this shelf.</h1>
      <p style="color:var(--ink-2);margin-bottom:24px">The page you're after doesn't exist — but every tool does.</p>
      <a class="btn btn-primary" href="/">Back to the toolbox</a>
    </div>
  </section>
</BaseLayout>
