---
import BaseLayout from '../layouts/BaseLayout.astro';
import { INDUSTRY_META, byIndustry } from '../tools';
---
<BaseLayout
  title="All Tools — Main Street Toolbox"
  description="Every free Main Street Toolbox calculator, grouped by trade — restaurant, cleaning, lawn care, construction, salon and retail. Free, instant, no signup."
  path="/tools/"
>
  <section class="section" style="padding-bottom:24px">
    <div class="container">
      <span class="eyebrow">The full toolbox</span>
      <h1 style="font-size:var(--fs-800);margin:12px 0 6px">All tools</h1>
      <p style="color:var(--ink-2);max-width:36rem">Every calculator is free, instant, and works without an account. New tools are added as they're built.</p>
    </div>
  </section>

  <section class="section" style="padding-top:18px">
    <div class="container">
      <a class="flag-card" href="/estimate-generator/">
        <div>
          <p class="flag-eyebrow">Most popular</p>
          <b>Free Estimate Generator</b>
          <p>10 trades with realistic 2026 price presets, itemized lines, tax &amp; deposit — print or PDF in minutes. No signup.</p>
        </div>
        <span class="go">Open tool →</span>
      </a>
    </div>
  </section>

  {Object.entries(INDUSTRY_META).map(([id, meta]) => {
    const tools = byIndustry(id);
    if (tools.length === 0) {
      return (
        <section class="section" style="padding-top:20px">
          <div class="container">
            <div class="section-head"><h2 style="font-size:1.2rem">{meta.name}</h2><span class="soon-badge">Coming soon</span></div>
            <p style="color:var(--ink-2);font-size:var(--fs-500)">{meta.blurb}.</p>
          </div>
        </section>
      );
    }
    return (
      <section class="section" style="padding-top:20px">
        <div class="container">
          <div class="section-head"><h2 style="font-size:1.2rem">{meta.name}</h2><a href={meta.path}>Trade page →</a></div>
          <div class="most-list">
            {id === 'restaurant' && (
              <a class="most-row" href="/menu-maker/">
                <b>Menu Maker</b><span class="tag" style="border:none;background:none;padding:0">design a printable menu — templates, PDF & PNG</span>
              </a>
            )}
            {tools.map((t) => (
              <a class="most-row" href={`/${t.industry}/${t.slug}/`}>
                <b>{t.name}</b><span class="tag" style="border:none;background:none;padding:0">{t.tagline}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}
  <section class="section" style="padding-top:20px">
    <div class="container">
      <div class="section-head"><h2 style="font-size:1.2rem">Pricing guides</h2></div>
      <div class="most-list">
        <a class="most-row" href="/benchmarks/service-pricing-2026/"><b>2026 Service Business Pricing Benchmarks</b><span class="tag" style="border:none;background:none;padding:0">every band, with sources — built to cite</span></a>
        <a class="most-row" href="/guides/house-cleaning-prices/"><b>How much to charge for house cleaning</b><span class="tag" style="border:none;background:none;padding:0">2026 pricing bands by clean type & frequency</span></a>
        <a class="most-row" href="/guides/cleaning-invoice-template/"><b>Free cleaning invoice template</b><span class="tag" style="border:none;background:none;padding:0">what to include & the terms that get you paid</span></a>
        <a class="most-row" href="/guides/food-cost-percentage/"><b>What's a healthy food cost percentage?</b><span class="tag" style="border:none;background:none;padding:0">restaurant benchmarks & the four levers</span></a>
        <a class="most-row" href="/guides/post-construction-cleaning-rates/"><b>How to price post-construction cleaning</b><span class="tag" style="border:none;background:none;padding:0">per-sqft ranges, scope checklists & bid structure</span></a>
        <a class="most-row" href="/guides/booth-rent-vs-commission/"><b>Booth rent vs commission</b><span class="tag" style="border:none;background:none;padding:0">the real math for stylists</span></a>
      </div>
    </div>
  </section>
<style>
.flag-card {
  display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; flex-wrap: wrap;
  border: 1.5px solid var(--green); border-radius: var(--r-m, 12px);
  padding: 1.1rem 1.4rem; background: var(--card); text-decoration: none;
}
.flag-card:hover { box-shadow: 0 6px 22px rgba(47, 94, 70, .12); }
.flag-card b { font-size: 1.15rem; font-family: var(--font-display); }
.flag-card p { margin: .25rem 0 0; color: var(--ink-2); max-width: 38rem; }
.flag-eyebrow { font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; color: var(--green); margin: 0; font-weight: 700; }
.flag-card .go { color: var(--green); font-weight: 700; white-space: nowrap; }
</style>
</BaseLayout>
