      { '@type': 'Question', name: 'What commission split should a new stylist expect?', acceptedAnswer: { '@type': 'Answer', text: 'New stylists commonly keep 40–50%, moving toward 60% with a proven book.' } },
      { '@type': 'Question', name: 'Do tips change the comparison?', acceptedAnswer: { '@type': 'Answer', text: 'No — tips follow you under both structures; keep the comparison to service revenue only.' } },
