---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOLS, INDUSTRY_META, byIndustry } from '../tools';

const searchIndex = [
  { n: 'Menu Maker', i: 'restaurant', t: 'design a printable menu', u: '/menu-maker/' },
  ...TOOLS.map((t) => ({ n: t.name, i: t.industry, t: t.tagline, u: `/${t.industry}/${t.slug}/` })),
];
---
<BaseLayout
  title="Main Street Toolbox — Free tools for people who actually run the place"
  description="Free calculators for restaurant owners, cleaners, crews and corner shops. Type your numbers, get the answer, get back to work. No signup, no ads."
  path="/"
>
  <header class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Free forever · No signup · No ads</span>
        <h1>The toolbox for people who <em>actually run the place.</em></h1>
        <p class="hero-sub">Calculators for restaurant owners, cleaners, crews and corner shops. Type your numbers, get the answer, get back to work.</p>
        <div class="search-wrap">
          <div class="searchbar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="search" placeholder="Search tools — try “tip out” or “food cost”" id="tool-search" aria-label="Search tools" autocomplete="off" />
          </div>
          <div class="search-pop" id="search-pop" aria-live="polite"></div>
        </div>
        <div class="hot-chips">
          <a class="chip" href="/menu-maker/" style="border-color:var(--green);color:var(--green);font-weight:600">Menu Maker — design & print</a>
          {TOOLS.slice(0, 3).map((t) => <a class="chip" href={`/${t.industry}/${t.slug}/`}>{t.name}</a>)}
        </div>
      </div>

      <div class="card mini-tool" aria-label="Live example: tip out calculator">
        <div class="mini-title"><span>Tip Out Calculator</span><span style="color:var(--green)">● live</span></div>
        <div class="mini-row">
          <input id="m-tips" inputmode="decimal" value="847" aria-label="Tips this week" />
          <input id="m-servers" inputmode="numeric" value="3" aria-label="Servers" />
        </div>
        <div class="mini-answer">
          <div class="num" id="m-out">$197.63</div>
          <div class="lbl">to each of <b id="m-n">3</b> servers <span style="color:var(--ink-3)">— after a 70 / 20 / 10 split</span></div>
        </div>
      </div>
    </div>
  </header>

  <section class="trust">
    <div class="container trust-in">
      <span><b>No signup</b> — every tool works instantly</span>
      <span><b>No ads</b> — your numbers stay yours</span>
      <span><b>Mobile-first</b> — built for the walk-in cooler, not the desk</span>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>Pick your trade</h2><a href="/tools">All tools →</a></div>
      <div class="trades">
        {Object.entries(INDUSTRY_META).map(([id, meta]) => (
          meta.live ? (
            <a class="trade" href={meta.path}>
              <span><b>{meta.name}</b><span>{byIndustry(id).length} tools · {meta.blurb}</span></span>
              <span class="go">→</span>
            </a>
          ) : (
            <span class="trade soon" aria-disabled="true">
              <span><b>{meta.name}</b><span>{meta.blurb}</span></span>
              <span class="soon-badge">Soon</span>
            </span>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="section most" style="border-top:1px solid var(--line)">
    <div class="container">
      <div class="section-head"><h2>The essentials</h2><a href="/tools">See all →</a></div>
      <div class="most-list" data-stats-sort>
        <a class="most-row" href="/menu-maker/" data-stats-slug="menu-maker">
          <span class="most-rank">1</span><b>Menu Maker</b><span class="tag">Restaurant</span>
          <span class="use" data-uses-for="menu-maker" hidden></span>
        </a>
        {TOOLS.slice(0, 4).map((t) => (
          <a class="most-row" href={`/${t.industry}/${t.slug}/`} data-stats-slug={t.slug}>
            <span class="most-rank">·</span><b>{t.name}</b><span class="tag">{INDUSTRY_META[t.industry]?.name ?? 'Tool'}</span>
            <span class="use" data-uses-for={t.slug} hidden></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    const tips = document.getElementById('m-tips') as HTMLInputElement;
    const n = document.getElementById('m-servers') as HTMLInputElement;
    const update = () => {
      const t = parseFloat(String(tips.value).replace(/[^0-9.]/g, '')) || 0;
      const c = Math.max(1, parseInt(n.value) || 1);
      document.getElementById('m-n')!.textContent = String(c);
      document.getElementById('m-out')!.textContent =
        '$' + ((t * 0.7) / c).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };
    tips.addEventListener('input', update);
    n.addEventListener('input', update);
  </script>

  <style>
    .search-wrap { position: relative; max-width: 34rem; }
    .search-pop {
      position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 30;
      background: var(--card); border: 1px solid var(--line-2); border-radius: var(--r-m);
      box-shadow: var(--shadow-2); overflow: hidden; display: none;
    }
    .search-pop.open { display: block; }
    .search-pop a { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 10px 14px; color: var(--ink); border-bottom: 1px solid var(--line); font-size: .95rem; }
    .search-pop a:last-child { border-bottom: 0; }
    .search-pop a:hover { background: var(--paper-2); text-decoration: none; }
    .search-pop a small { color: var(--ink-3); white-space: nowrap; }
    .search-pop .none { padding: 12px 14px; color: var(--ink-3); font-size: .9rem; }
  </style>

  <script define:vars={{ searchIndex }}>
    // 首页工具搜索：静态索引过滤，Enter 直达第一个结果
    const input = document.getElementById('tool-search');
    const pop = document.getElementById('search-pop');
    const renderPop = (q) => {
      if (!q) { pop.classList.remove('open'); return; }
      const hits = searchIndex
        .filter((t) => t.n.toLowerCase().includes(q) || t.i.includes(q) || t.t.toLowerCase().includes(q))
        .slice(0, 6);
      pop.innerHTML = hits.length
        ? hits.map((h) => `<a href="${h.u}"><b>${h.n}</b><small>${h.i}</small></a>`).join('')
        : '<div class="none">Nothing matches — try “food cost” or “invoice”.</div>';
      pop.classList.add('open');
    };
    input.addEventListener('input', () => renderPop(input.value.trim().toLowerCase()));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { const first = pop.querySelector('a'); if (first) location.href = first.getAttribute('href'); }
      if (e.key === 'Escape') { input.value = ''; pop.classList.remove('open'); }
    });
    document.addEventListener('click', (e) => { if (!e.target.closest('.search-wrap')) pop.classList.remove('open'); });
  </script>
</BaseLayout>
