---
import BaseLayout from '../layouts/BaseLayout.astro';
const updated = 'September 5, 2026';
---
<BaseLayout title="Terms of Use — Main Street Toolbox" description="Main Street Toolbox terms of use: free calculators provided as estimates for guidance only, not financial, legal or tax advice." path="/terms/">
  <div class="prose">
    <h1>Terms of Use</h1>
    <p style="color:var(--ink-3);font-size:var(--fs-400)">Last updated {updated}</p>
    <h2>Estimates, not advice</h2>
    <p>Main Street Toolbox provides free calculators for general guidance. Results are estimates based on the
    numbers you enter and typical industry ranges; they are not financial, legal, tax or accounting advice,
    and they do not replace a qualified professional. Decisions you make using these tools are your own.</p>
    <h2>Acceptable use</h2>
    <p>You may use the tools freely for your business, including printing and sharing results. You may not
    resell the site, scrape it at scale, or misrepresent it as your own product.</p>
    <h2>No warranty</h2>
    <p>The tools are provided "as is" without warranties of any kind. While we work hard to keep formulas and
    industry figures correct, we do not guarantee that results are error-free or fit your specific situation.</p>
    <h2>Contact</h2>
    <p>Questions: <a href="mailto:hello@mainstreettoolbox.com">hello@mainstreettoolbox.com</a>.</p>
  </div>
</BaseLayout>
