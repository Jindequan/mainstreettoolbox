---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    icon: '🏭',
    title: 'Storefront page design',
    desc: 'A clean, fast one-page site for your shop — your services, your prices, your photos. Built to look trustworthy and rank in local search.',
  },
  {
    icon: '🪪',
    title: 'Business card design',
    desc: 'A card customers keep, not toss. Print-ready, on-brand, and matched to the rest of how your business looks.',
  },
  {
    icon: '⚙️',
    title: 'Custom tools & SaaS',
    desc: 'A calculator, quote builder, or booking flow built around how you actually work. Yours alone, on your own domain.',
  },
  {
    icon: '💡',
    title: 'Tech consulting',
    desc: 'Straight answers about websites, software and automation — what is worth paying for, and what is not. One call or ongoing.',
  },
];
---

<BaseLayout
  title="Contact — get help with your business — Main Street Toolbox"
  description="I build storefront pages, business cards, custom calculators and SaaS tools for small shops. Email me and get a straight answer within 48 hours."
  path="/contact/"
>
  <section class="section" style="padding-bottom:8px">
    <div class="container contact-wrap">
      <span class="eyebrow">Beyond the free tools</span>
      <h1 style="font-size:var(--fs-800);margin:12px 0 10px">The tools are free. I can also just build it for you.</h1>
      <p style="color:var(--ink-2);font-size:1.0625rem;max-width:40rem">
        If a calculator on this site got you halfway, I can take you the rest of the way —
        a real page for your shop, a card that looks right, or a tool made exactly for your trade.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:20px;padding-bottom:8px">
    <div class="container contact-wrap">
      <div class="svc-grid">
        {services.map((s) => (
          <div class="svc-card">
            <div class="svc-icon" aria-hidden="true">{s.icon}</div>
            <h2>{s.title}</h2>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:24px;padding-bottom:56px">
    <div class="container contact-wrap">
      <div class="card card-pad contact-box">
        <h2 style="font-size:var(--fs-600);margin:0 0 8px">How to reach me</h2>
        <p style="color:var(--ink-2);margin:0 0 20px">
          Email tells me you're serious, so email is all there is. Tell me your trade and what you need —
          you'll get a real reply from a real person within 48 hours.
        </p>
        <a
          href="mailto:feedback@mainstreettoolbox.com?subject=I%20need%20help%20with%20my%20business&body=Hi%20Devin%2C%0A%0AMy%20business%20(a%20little%20about%20it):%20%0AWhat%20I%20need%20help%20with:%20%0A%0AThanks!"
          class="btn btn-primary contact-btn"
        >
          <span>📧 Email Devin</span>
          <span class="cb-mail">feedback@mainstreettoolbox.com</span>
        </a>
        <p class="form-note">
          Free estimates for any project. No newsletters, no spam — your address is used to reply, that's it.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-wrap { max-width: 52rem; }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 620px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
  .svc-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 22px 20px;
  }
  .svc-card h2 {
    font-family: var(--font-display);
    font-size: var(--fs-600);
    margin: 10px 0 6px;
  }
  .svc-card p { color: var(--ink-2); font-size: var(--fs-400); margin: 0; line-height: 1.55; }
  .svc-icon { font-size: 1.6rem; line-height: 1; }
  .contact-box { max-width: 34rem; }
  .contact-btn { display: flex; flex-direction: column; gap: 3px; height: auto; padding: 13px 16px; }
  .cb-mail { font-size: 0.92em; font-weight: 500; overflow-wrap: anywhere; }
</style>
