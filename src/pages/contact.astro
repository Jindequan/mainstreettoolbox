---
import BaseLayout from '../layouts/BaseLayout.astro';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
---

<BaseLayout
  title="Contact Us — Main Street Toolbox"
  description="Get in touch with Devin — I help businesses with storefront pages, business cards, SaaS development, and technical consulting."
  path="/contact/"
>
  <!-- Hero Section -->
  <section class="section" style="padding-bottom:12px">
    <div class="container" style="max-width:44rem">
      <span class="eyebrow">Get in touch</span>
      <h1 style="font-size:var(--fs-800);margin:12px 0 8px">I'm Devin, and I can help you grow your business.</h1>
      <p style="color:var(--ink-2);font-size:1.0625rem">
        Whether you need a professional storefront page, a business card that makes an impression, a custom SaaS system, or just some technical advice — I'm here to help.
      </p>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section" style="padding-top:24px;padding-bottom:40px">
    <div class="container">
      <h2 style="text-align:center;font-size:var(--fs-600);margin-bottom:32px">What I can do for you</h2>
      <div class="services-grid">
        <!-- Service 1: Storefront Page -->
        <div class="service-card">
          <div class="service-icon">🎨</div>
          <h3>Storefront Page Design</h3>
          <p>Professional, SEO-optimized storefront page that makes your business look trustworthy and modern. Perfect for local shops, service businesses, and more.</p>
        </div>

        <!-- Service 2: Business Card Design -->
        <div class="service-card">
          <div class="service-icon">📇</div>
          <h3>Business Card Design</h3>
          <p>Stand out from the competition with a business card that reflects your brand. High-quality designs that make an immediate impression.</p>
        </div>

        <!-- Service 3: SaaS Development -->
        <div class="service-card">
          <div class="service-icon">🚀</div>
          <h3>SaaS Development</h3>
          <p>From zero to one — I build custom SaaS systems tailored to your business needs. Automate your workflows, impress your customers, and scale efficiently.</p>
        </div>

        <!-- Service 4: Technical Consulting -->
        <div class="service-card">
          <div class="service-icon">💡</div>
          <h3>Technical Consulting</h3>
          <p>Not sure if an idea is feasible? Got a technical question? I can help you evaluate projects, provide technical roadmaps, or answer your questions one-on-one.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section" style="padding-top:24px">
    <div class="container" style="max-width:600px">
      <div class="card card-pad form-card">
        <h2 style="font-size:var(--fs-600);margin-bottom:20px">Let's talk</h2>
        <p style="color:var(--ink-2);margin-bottom:20px">
          Fill in your details below and I'll get back to you within 24-48 hours. No spam, no newsletters — just helpful conversations.
        </p>

        <a
          href="mailto:feedback@mainstreettoolbox.com?subject=Contact%20from%20mainstreettoolbox.com&body=Name:%0A%0AEmail:%0A%0AWhat%20service%20are%20you%20interested%20in%3F%0A%0AYour%20message:%0A"
          class="btn btn-primary"
          style="display:inline-block;width:100%;text-align:center"
        >
          📧 Send me a message
        </a>

        <div style="margin-top:24px;padding-top:24px;border-top:1px solid var(--ink-2)">
          <p style="color:var(--ink-2);margin-bottom:12px">Or reach me directly:</p>
          <a href="mailto:feedback@mainstreettoolbox.com" style="color:var(--primary);text-decoration:underline">
            feedback@mainstreettoolbox.com
          </a>
        </div>

        <p class="form-note" style="margin-top:20px">I'm Devin — I help businesses with storefront pages, business cards, SaaS systems, and technical consulting.</p>
      </div>
    </div>
  </section>
</BaseLayout>
