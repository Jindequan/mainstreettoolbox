      MN: { name: 'Minnesota', days: 21, kind: 'cal', trigger: 'termElseVacate', daysRule: '21 days (three weeks) after the tenancy ends and you provide a forwarding address. A narrow 5-day rule applies in foreclosure-related evictions.', statute: 'Minn. Stat. §504B.178', url: 'https://www.revisor.mn.gov/statutes/cite/504b.178',
