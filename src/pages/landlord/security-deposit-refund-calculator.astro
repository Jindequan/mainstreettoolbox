      OK: { name: 'Oklahoma', days: 45, kind: 'cal', trigger: 'termElseVacate', daysRule: '45 calendar days for deposits over $125 (30 days for deposits of $125 or less) after termination and forwarding address. You must request the return within 6 months.', statute: '41 O.S. §115', url: 'https://law.justia.com/codes/oklahoma/title-41/section-41-115/',
        statement: 'Itemized accounting of deductions due with the refund.',
        penalty: 'The statute sets no multiplier — disputes run through ordinary claims.' },
      AR: { name: 'Arkansas', days: 60, kind: 'cal', trigger: 'vacate', daysRule: '60 calendar days after you vacate (the statewide deadline statute dates from 2021 — before that Arkansas had no fixed rule).', statute: 'A.C.A. §18-16-305', url: 'https://www.arkleg.state.ar.us',
        statement: 'Itemized deduction list due with the refund inside the 60 days.',
        penalty: 'The statute sets no multiplier — disputes run through ordinary claims.' },
      LA: { name: 'Louisiana', days: 1, kind: 'month', trigger: 'termElseVacate', daysRule: 'One calendar month after termination of the lease.', statute: 'La. Rev. Stat. §9:3251', url: 'https://www.legis.la.gov/legis/Law.aspx?d=79246',
        statement: 'Itemized damages statement due with the refund balance inside the month.',
        penalty: 'The statute sets no multiplier — disputes run through ordinary claims.' },
      MS: { name: 'Mississippi', days: 45, kind: 'cal', trigger: 'later', daysRule: '45 calendar days after the later of the end of tenancy and delivery of possession.', statute: 'Miss. Code §89-8-21', url: 'https://law.justia.com/codes/mississippi/title-89/chapter-8/article-3/section-89-8-21/',
        statement: 'Written itemization of deductions due with the balance.',
        penalty: 'The statute sets no multiplier — disputes run through ordinary claims.' },
      ME: { name: 'Maine', days: 21, kind: 'cal', trigger: 'later', daysRule: '21 calendar days for tenancies at will; a written lease sets its own period (commonly 30 days).', statute: '14 M.R.S. §6033', url: 'https://legislature.maine.gov/statutes/14/title14sec6033.html',
        statement: 'Itemized written statement of deductions due with the refund.',
        penalty: 'The statute sets no multiplier — disputes run through ordinary claims.' },
      NH: { name: 'New Hampshire', days: 30, kind: 'cal', trigger: 'termElseVacate', daysRule: '30 calendar days from termination, with any interest due. The landlord gets up to 20 additional days to itemize damages after sending a written statement.', statute: 'N.H. RSA 540-A', url: 'https://gc.nh.gov/rsa/html/LV/540-A/540-A-mrg.htm',
        statement: 'Written itemization of damages due with the refund (with the 20-day extension where damages need estimating).',
        penalty: 'Willful non-compliance can cost the landlord 2× the deposit or $1,000, whichever is less, plus damages.' },
      RI: { name: 'Rhode Island', days: 20, kind: 'cal', trigger: 'later', daysRule: '20 calendar days from the later of termination, delivery of possession, or receipt of your forwarding address. (Deposits capped at one month\'s rent.)', statute: 'R.I. Gen. Laws §34-18-19', url: 'https://webserver.rilegislature.gov/statutes/title34/34-18/34-18-19.HTM',
        statement: 'Itemized deductions due with the refund inside the 20 days.',
        penalty: 'The statute sets no multiplier — disputes run through ordinary claims.' },
      VT: { name: 'Vermont', days: 14, kind: 'cal', trigger: 'vacate', daysRule: '14 calendar days from the landlord learning you left. (Seasonal rentals run on 60 days.)', statute: '9 V.S.A. §4461', url: 'https://legislature.vermont.gov/statutes/section/09/137/04461',
        statement: 'Refund plus a written statement due inside the 14 days.',
        penalty: 'Wrongful withholding can cost the landlord up to 2× the wrongfully withheld amount.' },
      DE: { name: 'Delaware', days: 20, kind: 'cal', trigger: 'later', daysRule: '20 calendar days after the later of lease termination and your vacating. After a year of tenancy, any deposit over one month\'s rent must be returned as a credit immediately.', statute: '25 Del. C. §5514', url: 'https://delcode.delaware.gov/title25/c055/index.html',
        statement: 'Itemized statement due with the refund inside the 20 days.',
        penalty: 'The statute sets no multiplier — disputes run through ordinary claims.' },
      WV: { name: 'West Virginia', days: 60, kind: 'cal', trigger: 'termElseVacate', daysRule: '60 calendar days after termination when a forwarding address was provided (45 days when it was not); the landlord gets 15 additional days to itemize once notice is given.', statute: 'W. Va. Code §37-6A-1', url: 'https://code.wvlegislature.gov/37-6A-1',
        statement: 'Itemized written notice of deductions due inside the window.',
        penalty: 'The statute sets no multiplier — disputes run through ordinary claims.' },
      AK: { name: 'Alaska', days: 14, kind: 'cal', trigger: 'vacate', daysRule: '14 calendar days after surrender — extended to 30 days when the landlord has good cause to deduct for damages or unpaid rent.', statute: 'Alaska Stat. §34.03.070', url: 'https://codes.findlaw.com/ak/title-34-property/ak-st-sect-34-03-070/',
        statement: 'Itemized deductions due with the refund inside the applicable window.',
        penalty: 'The statute sets no multiplier — disputes run through ordinary claims.',
        altDays: 30, altLabel: 'Extended window when the landlord claims deductions (30 days)' },
      HI: { name: 'Hawaii', days: 14, kind: 'cal', trigger: 'later', daysRule: '14 calendar days after the later of termination of the rental agreement or surrender of the unit. (Deposits capped at one month\'s rent, plus a separate pet deposit.)', statute: 'HRS §521-44', url: 'https://law.justia.com/codes/hawaii/title-28/chapter-521/section-521-44/',
        statement: 'Itemized list of deductions due with the refund inside the 14 days.',
        penalty: 'The statute sets no deadline multiplier — disputes run through ordinary claims.' },
      DC: { name: 'District of Columbia', days: 45, kind: 'cal', trigger: 'termElseVacate', daysRule: '45 calendar days after termination to return the unused portion with interest.', statute: 'D.C. Code §42-3502.17–.18', url: 'https://code.dccouncil.gov/us/dc/council/code/sections/42-3502.17',
        statement: 'Written notice of deductions with an itemized list due inside the 45 days.',
        penalty: 'Claiming deductions without the required written itemization forfeits the right to withhold.' },
      KY: { name: 'Kentucky', days: 30, kind: 'cal', trigger: 'vacate', daysRule: '30 calendar days after move-out — but the Kentucky URLTA applies only where a county or city has adopted it (e.g. Fayette and Jefferson counties); elsewhere your lease sets the deadline.', statute: 'KRS §383.580 (URLTA — adopted jurisdictions only)', url: 'https://apps.legislature.ky.gov/law/statutes/statute.aspx?id=35733',
        statement: 'Itemized list of deductions plus the balance due within the 30 days; tenants have 60 days to dispute the itemization in writing.',
        penalty: 'A dispute upheld within 60 days recovers the deposit plus reasonable attorney\'s fees.' },
      TN: { name: 'Tennessee', days: 30, kind: 'cal', trigger: 'vacate', daysRule: '30 calendar days after move-out (or 7 days after a new tenant takes possession) — the Tennessee URLTA applies only in counties with 75,000+ residents (e.g. Davidson, Shelby, Knox, Hamilton); elsewhere your lease sets the deadline.', statute: 'Tenn. Code Ann. §66-28-301 (URLTA — qualifying counties only)', url: 'https://law.justia.com/codes/tennessee/title-66/chapter-28/part-3/section-66-28-301/',
        statement: 'Refund with an itemized list of any deductions due inside the window.',
        penalty: 'No statutory multiplier — outside URLTA counties, disputes run through breach-of-contract claims on the lease.' },
      WY: { name: 'Wyoming', days: 0, kind: 'cal', trigger: 'none', daysRule: 'Wyoming has no state security-deposit return statute — your lease sets the deadline, and the demand letter should cite the lease clause. (Court practice treats about 30 days as reasonable, but that is case law, not a statute.)', statute: 'Wyoming Judicial Branch — Security Deposits (no state statute)', url: 'https://www.wyocourts.gov/legal-help-by-topic/security-deposits',
        statement: 'Your lease dictates what must be returned and when — quote its deposit clause.',
        penalty: 'Recourse is a breach-of-contract claim on the lease, not a statutory penalty.' },
    };

    const $ = (id) => document.getElementById(id);
    const fmt = (s) => p(s).toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

    function render() {
      const code = $('state').value;
      const R = RULES[code];
      const vacate = $('vacate').value;
      const term = $('termination').value;
      const demand = $('demand').value;
      if (!vacate) { $('out-deadline').textContent = '—'; return; }

      $('demand-field').hidden = !(code === 'AZ' || code === 'SC');
      $('claim-field').hidden = code !== 'FL';

      let trigger, deadline, alt = null;
      const claims = code === 'FL' && $('claim').value === 'yes';
      if (R.trigger === 'none') { trigger = vacate; deadline = null; }
      else if (R.trigger === 'vacate') { trigger = vacate; deadline = addDays(vacate, R.days); if (R.altDays) alt = { label: R.altLabel, date: addDays(vacate, R.altDays) }; }
      else if (R.trigger === 'termination') { trigger = term || vacate; deadline = addDays(trigger, claims ? R.claimDays : R.days); alt = claims ? { label: 'Tenant objection window closes', date: addDays(deadline, 15) } : { label: 'Claim-notice deadline if the landlord does claim', date: addDays(trigger, 30) }; }
      else if (R.trigger === 'later') { trigger = later(vacate, term); deadline = R.kind === 'month' ? monthClamp(trigger, R.days) : addDays(trigger, R.days); if (R.cap) alt = { label: 'Absolute cap with a lease extension (60 days)', date: addDays(trigger, R.cap) }; else if (R.altDays) alt = { label: R.altLabel, date: addDays(trigger, R.altDays) }; }
      else if (R.trigger === 'laterDemand') { trigger = later(later(vacate, term), demand); deadline = R.kind === 'biz' ? biz(trigger, R.days) : addDays(trigger, R.days); }
      else { trigger = term || vacate; deadline = addDays(trigger, R.days); }

      if (deadline === null) {
        $('out-deadline').textContent = 'No statutory deadline — your lease governs';
        $('out-days').innerHTML = R.daysRule;
      } else {
        $('out-deadline').textContent = fmt(deadline);
        const daysLeft = Math.round((p(deadline) - p(new Date().toISOString().slice(0, 10))) / MS);
        $('out-days').innerHTML = R.daysRule + (daysLeft >= 0 ? ' <em>(' + daysLeft + ' days from today)</em>' : ' <em>(' + (-daysLeft) + ' days ago)</em>');
      }
      $('out-trigger').textContent = fmt(trigger) + ' — ' + (R.trigger === 'vacate' ? 'the day tenants vacate' : R.trigger === 'termination' ? 'lease termination' : R.trigger === 'later' ? 'the later of termination / move-out' : R.trigger === 'laterDemand' ? 'the latest of termination / move-out / written demand' : 'lease termination (or move-out when no term applies)');
      if (alt) { $('out-alt-row').hidden = false; $('out-alt-label').textContent = alt.label; $('out-alt').textContent = fmt(alt.date); }
      else $('out-alt-row').hidden = true;
      $('out-penalty').innerHTML = '<strong>If the deadline slips:</strong> ' + R.penalty;
      $('out-statement').textContent = R.statement;
      $('out-cite').textContent = R.statute;
      $('out-statute-link').href = R.url;
    }

    ['state', 'vacate', 'termination', 'demand', 'claim'].forEach((id) =>
      $(id).addEventListener(id === 'vacate' || id === 'deposit' ? 'input' : 'change', render));
    $('deposit') && $('deposit').addEventListener('input', render);
    render();
  </script>
</BaseLayout>

<style>
  .opt { color: var(--ink-2); font-weight: 400; font-size: 0.85rem; }
  .ans-row.big b { font-size: 1.9rem; color: var(--green); }
  .ans-row .small { font-size: 0.95rem; font-weight: 600; }
  .penalty { margin: 0.9rem 0 0.4rem; font-size: 0.95rem; line-height: 1.55; }
  .statute { font-size: 0.85rem; color: var(--ink-2); margin: 0; }
  .section-sub { max-width: 68ch; }
  .body-copy { max-width: 72ch; }
  .table-scroll { overflow-x: auto; margin: 1rem 0 1.5rem; }
  .state-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .state-table th, .state-table td { border: 1px solid var(--line); padding: 0.5rem 0.7rem; text-align: left; vertical-align: top; }
  .state-table th { background: var(--green-tint); }
  .faq details { border-bottom: 1px solid var(--line); padding: 0.7rem 0; max-width: 76ch; }
  .faq summary { font-weight: 600; cursor: pointer; }
  .faq p { margin: 0.5rem 0 0.25rem; color: var(--ink-2); }
</style>
