      OH: { name: 'Ohio', days: 30, kind: 'cal', trigger: 'later', daysRule: '30 calendar days after the later of lease termination and delivery of possession.', statute: 'Ohio Rev. Code §5321.16', url: 'https://codes.ohio.gov/ohio-revised-code/section-5321.16',
        statement: 'Written itemized deduction list due with the balance; deposits over $50 (or one month\'s rent) bear interest on amounts held past six months.',
