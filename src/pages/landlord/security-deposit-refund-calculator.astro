      VA: { name: 'Virginia', days: 45, kind: 'cal', trigger: 'termElseVacate', daysRule: '45 calendar days after lease termination. (Deposits are capped at two months\' periodic rent.)', statute: 'Va. Code §55.1-1226', url: 'https://law.lis.virginia.gov/vacode/title55.1/chapter12/section55.1-1226',
        statement: 'Written itemized notice of damages due with the refund; tenants owe the landlord written notice of their forwarding address.',
