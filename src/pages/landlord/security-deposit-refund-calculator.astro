      IA: { name: 'Iowa', days: 30, kind: 'cal', trigger: 'later', daysRule: '30 calendar days after the later of termination and delivery of possession.', statute: 'Iowa Code §562A.12', url: 'https://www.legis.iowa.gov/docs/ico/chapter/562a.pdf',
        statement: 'Written itemized statement due with the refund.',
        penalty: 'Failure to comply can expose the landlord to punitive damages of up to 2× the monthly rent.' },
      KS: { name: 'Kansas', days: 30, kind: 'cal', trigger: 'termElseVacate', daysRule: 'Never more than 30 days after termination and possession/forwarding address: once the landlord determines deductions, the balance is due within 14 days. (Caps: 1 month unfurnished, 1.5 furnished.)', statute: 'K.S.A. §58-2550', url: 'https://ksrevisor.gov/statutes/chapters/ch58/058_025_0050.html',
        statement: 'Itemized deductions due when the balance is returned inside the 30-day outer limit.',
        penalty: 'The statute sets no multiplier — disputes run through ordinary claims.' },
      NV: { name: 'Nevada', days: 30, kind: 'cal', trigger: 'termElseVacate', daysRule: '30 calendar days after the end of the tenancy.', statute: 'NRS §118A.242', url: 'https://www.leg.state.nv.us/nrs/nrs-118a.html',
        statement: 'Written itemized accounting of deductions due with the balance.',
        penalty: 'Failure to return the remainder within 30 days makes the landlord liable for the deposit plus damages.' },
      UT: { name: 'Utah', days: 30, kind: 'cal', trigger: 'vacate', daysRule: '30 calendar days after you vacate — or within 15 days after the landlord receives your forwarding address, whichever is later.', statute: 'Utah Code §57-17-3', url: 'https://le.utah.gov/xcode/Title57/Chapter17/57-17-S3.html',
        statement: 'Refund or a written itemized statement due inside the window.',
        penalty: 'Failure requires refunding the entire deposit plus statutory penalties.' },
      OR: { name: 'Oregon', days: 31, kind: 'cal', trigger: 'later', daysRule: '31 calendar days after the later of termination and delivery of possession. (A 4-day rule applies when the landlord terminates for cause.)', statute: 'ORS §90.300', url: 'https://oregon.public.law/statutes/ors_90.300',
        statement: 'Written accounting for any withheld amount due inside the 31 days.',
        penalty: 'The statute sets no deadline multiplier — disputes run through ordinary claims.' },
      NM: { name: 'New Mexico', days: 30, kind: 'cal', trigger: 'termElseVacate', daysRule: '30 calendar days after lease termination.', statute: 'NMSA §47-8-18', url: 'https://law.justia.com/codes/new-mexico/chapter-47/article-8/section-47-8-18/',
        statement: 'Itemized accounting due with any withheld-balance refund.',
        penalty: 'Wrongful retention forfeits the right to withhold any amount and adds a $250 civil penalty for bad faith.' },
      ND: { name: 'North Dakota', days: 30, kind: 'cal', trigger: 'vacate', daysRule: '30 calendar days after you vacate. (Caps: 1 month\'s rent unfurnished, 1.5 furnished.)', statute: 'N.D. Cent. Code §47-16-07.1', url: 'https://codes.findlaw.com/nd/title-47-property/nd-cent-code-sect-47-16-07-1.html',
        statement: 'Itemized deductions due with the balance inside the 30 days.',
        penalty: 'The statute sets no multiplier — disputes run through ordinary claims.' },
      SD: { name: 'South Dakota', days: 14, kind: 'cal', trigger: 'termElseVacate', daysRule: '14 days (two weeks) after termination and receipt of your forwarding address. Cleanup/repair estimates can extend the itemization to 45 days.', statute: 'S.D. Codified Laws §43-32-24', url: 'https://sdlegislature.gov/Statutes/Codified_Laws/2045459',
        statement: 'Itemized list of damages due with the refund; up to 45 days when costs need estimating.',
