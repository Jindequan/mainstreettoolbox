      IL: { name: 'Illinois', days: 45, kind: 'cal', trigger: 'vacate', daysRule: '45 calendar days after move-out (raised from 30 days by the 2024 amendment — older guides still print 30). A separate written itemized statement of damages is due sooner: within 30 days of vacate. The Act exempts buildings with 5 or more units.', statute: '765 ILCS 710/1', url: 'https://www.ilga.gov/Legislation/ILCS/Articles?ActID=2202&ChapterID=62',
        statement: 'Written itemized statement of damages due within 30 days of vacate; the refund itself is due within 45.',
        penalty: 'Willful non-compliance = 2× the deposit plus court costs and attorney\'s fees.' },
      MA: { name: 'Massachusetts', days: 30, kind: 'cal', trigger: 'termElseVacate', daysRule: '30 calendar days after termination of the tenancy.', statute: 'Mass. Gen. Laws c.186 §15B', url: 'https://www.mass.gov/info-details/mass-general-laws-c186-ss-15b',
        statement: 'Refund or an itemized list of damages due within the same 30 days; the deposit must sit in a separate escrow account earning 5% or the bank\'s rate.',
        penalty: 'Violations expose the landlord to 3× the amount at issue plus attorney\'s fees and court costs — the harshest deposit statute in the country.' },
      NJ: { name: 'New Jersey', days: 30, kind: 'cal', trigger: 'termElseVacate', daysRule: '30 calendar days after termination of the lease.', statute: 'N.J.S.A. 2A:18-61.9', url: 'https://www.nj.gov/dca/codes/publications/pdf_lti/evic_law.pdf',
        statement: 'Any claim requires a written itemized list of damages delivered with the refund balance.',
