      ID: { name: 'Idaho', days: 21, kind: 'cal', trigger: 'vacate', daysRule: '21 calendar days after surrender unless the rental agreement fixes a different period — in any event never more than 30 days.', statute: 'Idaho Code §6-321', url: 'https://legislature.idaho.gov/statutesrules/idstat/title6/t6ch3/sect6-321',
        statement: 'Refund or the balance plus an itemized statement of deductions due inside the window.',
