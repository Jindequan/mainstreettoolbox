      MI: { name: 'Michigan', days: 30, kind: 'cal', trigger: 'termElseVacate', daysRule: '30 calendar days after termination of occupancy.', statute: 'Mich. Comp. Laws §554.614', url: 'https://www.legislature.mi.gov/Laws/MCL?objectName=mcl-554-614',
        statement: 'Itemized damage list mailed first-class to your forwarding address with the undisputed balance enclosed; you have 7 days after receipt to dispute it in writing.',
        penalty: 'Non-compliance = 2× the deposit amount in damages.' },
      IN: { name: 'Indiana', days: 45, kind: 'cal', trigger: 'later', daysRule: '45 calendar days after the later of lease termination and delivery of possession.', statute: 'Ind. Code §32-31-3-12', url: 'https://codes.findlaw.com/in/title-32-property/in-code-sect-32-31-3-12/',
        statement: 'Written itemized list of due deductions accompanies the refund.',
        penalty: 'No statutory multiplier — the landlord owes the full deposit due plus reasonable attorney\'s fees.' },
      MO: { name: 'Missouri', days: 30, kind: 'cal', trigger: 'termElseVacate', daysRule: '30 calendar days after termination of the tenancy. (Deposits are capped at two months\' rent.)', statute: 'Mo. Rev. Stat. §535.300', url: 'https://revisor.mo.gov/main/OneSection.aspx?section=535.300',
        statement: 'Written itemized list of damages due with the refund balance.',
