      CT: { name: 'Connecticut', days: 21, kind: 'cal', trigger: 'termElseVacate', daysRule: '21 calendar days after termination — or within 15 days after the landlord receives your written forwarding address, whichever is later (raised under Public Act 23-207; the old 30-day rule is gone). In an eviction case: 30 days after judgment.', statute: 'Conn. Gen. Stat. §47a-21', url: 'https://portal.ct.gov/dob/rental-security-deposits/rental-security-deposits/rental-security-deposits',
        statement: 'Refund with interest, or written notice of damages claimed, due inside the same window.',
