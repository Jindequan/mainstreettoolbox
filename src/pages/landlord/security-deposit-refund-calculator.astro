      MT: { name: 'Montana', days: 30, kind: 'cal', trigger: 'vacate', daysRule: '30 calendar days to refund with an itemized list of damages. When nothing is owed, the full deposit goes back within 10 days.', statute: 'Mont. Code Ann. §70-25-202 / §70-25-206', url: 'https://mca.legmt.gov/bills/mca/title_0700/chapter_0250/part_0020/section_0020/0700-0250-0020-0020.html',
        statement: 'Written itemized list of damages due with the refund inside the 30 days.',
        penalty: 'Bad-faith retention can expose the landlord to treble (3×) damages.',
        altDays: 10, altLabel: 'Fast track when nothing is deducted (10 days)' },
      NE: { name: 'Nebraska', days: 14, kind: 'cal', trigger: 'termElseVacate', daysRule: '14 calendar days after termination (with your demand or a payment location provided) to refund or send an itemized accounting. (Deposits are generally capped at one month\'s rent.)', statute: 'Neb. Rev. Stat. §76-1416', url: 'https://nebraskalegislature.gov/laws/statutes.php?statute=76-1416',
        statement: 'Itemized accounting of deductions due inside the same 14 days.',
