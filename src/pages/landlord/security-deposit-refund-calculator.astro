      GA: { name: 'Georgia', days: 30, kind: 'cal', trigger: 'later', daysRule: 'One month (30 calendar days) after the later of lease termination and delivery of possession. (A 2024 law caps deposits at two months\' rent.)', statute: 'O.C.G.A. §44-7-55', url: 'https://law.justia.com/codes/georgia/title-44/chapter-7/article-3/section-44-7-55/',
