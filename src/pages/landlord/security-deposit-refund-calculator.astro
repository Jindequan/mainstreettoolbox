        penalty: 'Missing the 30-day notice window forfeits the right to impose any claim on the deposit.' },
      WA: { name: 'Washington', days: 30, kind: 'cal', trigger: 'later', daysRule: '30 calendar days after the later of termination or move-out (raised from 21 days in July 2023).', statute: 'RCW 59.18.280', url: 'https://app.leg.wa.gov/RCW/default.aspx?cite=59.18.280',
