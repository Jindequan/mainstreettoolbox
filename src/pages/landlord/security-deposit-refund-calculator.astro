      SC: { name: 'South Carolina', days: 30, kind: 'cal', trigger: 'laterDemand', daysRule: '30 calendar days from the latest of: termination of the tenancy, surrender and delivery of possession, or your written demand for the deposit.', statute: 'S.C. Code §27-40-410', url: 'https://www.scstatehouse.gov/code/t27c040.php',
